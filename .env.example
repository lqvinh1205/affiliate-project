# Supabase Postgres — pooler (transaction mode, cổng 6543) cho runtime
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Kết nối trực tiếp/session (cổng 5432) cho prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Database cho `npm run test:db` — chỉ Postgres cục bộ (docker compose, cổng 54329), tên kết thúc `_test`;
# bộ test xoá sạch database này mỗi lần chạy.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/affiliate_test"

# Đăng nhập CMS (HTTP Basic Auth)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="doi-mat-khau-dai-va-kho-doan"

# Thư mục lưu file upload từ CMS (ảnh, video) — đĩa cục bộ của máy chủ, đường dẫn tuyệt đối, ngoài `public/`
# và `.next/` (spine AD-24). Thiếu biến này thì upload báo lỗi (fail closed). Sao lưu thư mục này cùng Postgres:
# xem docs/kiem-chung.md §5.
UPLOAD_DIR="/var/lib/affiliate-project/uploads"

# Lớp AI (`platform/ai`, spine AD-10). Không dùng OpenAI.
# Nhà cung cấp theo thứ tự ưu tiên, cách nhau bằng dấu phẩy; nhà lỗi / hết hạn mức thì tự chuyển nhà sau (NFR-2).
# Hiện có: `claude-cli` (Claude Code CLI `claude -p`, chốt tạm 2026-11-05). `fake` chỉ dùng cho test.
AI_PROVIDERS="claude-cli"
# Hạn mỗi lần gọi AI, mili giây (NFR-3: ≤ 90 giây; `maxDuration` của route CMS là 120).
AI_TIMEOUT_MS="90000"
# Claude Code CLI: cài `claude` trên máy chủ và đăng nhập một lần bằng tài khoản gói thuê bao (`claude` rồi /login).
# Mỗi lần gọi trừ vào hạn mức của gói, dùng chung với Claude Code của Vinh (gói Pro/Max có hạn mức theo phiên 5 giờ
# và theo tuần, không tính thêm tiền — NFR-9). Không cần API key; `--bare` không dùng được đăng nhập bằng gói.
CLAUDE_CLI_PATH="claude"
# Model theo profile của prompt: `fast` (chấm SEO, chuỗi Threads) và `quality` (nghiên cứu, viết bài).
CLAUDE_CLI_MODEL_FAST="haiku"
CLAUDE_CLI_MODEL_QUALITY="sonnet"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
