model Product {
  id           String        @id @default(uuid())
  name         String
  image        String?
  price        String?
  affiliateUrl String // link affiliate do admin tạo sẵn từ Shopee Affiliate
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  postProducts PostProduct[]

  @@index([categoryId])
}
