// Hồ sơ phong cách của từng nền tảng (FR-18, spine AD-25). Chủ: module `style-profiles`. Một bản ghi mỗi nền tảng,
// tạo lười khi Vinh lưu lần đầu: thiếu bản ghi = dùng giá trị khởi tạo ở `modules/style-profiles/constants.ts`.
// Chỉ chứa mục tiêu mềm; mục tiêu phải ≤ giới hạn cứng của module chủ nội dung (kiểm ở `style-profiles/schema.ts`).
// Nghĩa của `lengthMin`/`lengthMax`, `partsMin`/`partsMax` theo nền tảng: xem `STYLE_LENGTH_FIELDS` trong constants.
model StyleProfile {
  id          String       @id @default(uuid())
  platform    Platform     @unique
  voice       String       @db.VarChar(1000) // STYLE_VOICE_MAX (modules/style-profiles/constants.ts)
  lengthMin   Int
  lengthMax   Int
  partsMin    Int?
  partsMax    Int?
  emoji       String       @db.VarChar(300) // STYLE_EMOJI_MAX
  forbidden   String       @db.VarChar(1000) // STYLE_FORBIDDEN_MAX
  rules       String       @db.VarChar(1000) // STYLE_RULES_MAX
  /// Câu công khai chèn vào Bình luận kèm link (FR-18); chỉ Threads, Facebook; null = không chèn.
  disclosure  String?      @db.VarChar(200) // STYLE_DISCLOSURE_MAX
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// Quan hệ ngược (AD-4): bảng của `content-sets`.
  socialPosts SocialPost[]
}
