generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  content        String    @db.Text // HTML đã sanitize
  excerpt        String?   @db.VarChar(500)
  featuredImage  String? // null → dùng ảnh sản phẩm đầu tiên hoặc placeholder
  category       Category
  tags           String[]
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  status         Status    @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([status, category, publishedAt])
}

model Product {
  id           String  @id @default(uuid())
  name         String
  image        String?
  price        String?
  affiliateUrl String // link affiliate do admin tạo sẵn từ Shopee Affiliate
  sortOrder    Int     @default(0)
  postId       String
  post         Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

enum Category {
  MEO_VAT
  GOM_LINK
}

enum Status {
  DRAFT
  PUBLISHED
}
